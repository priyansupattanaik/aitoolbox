# Public build settings (safe to expose)
VITE_SITE_TITLE=AI ToolBox
VITE_SITE_AUTHOR=Priyansu Pattanaik
VITE_GITHUB_REPO_URL=https://github.com/priyansupattanaik/aitoolbox

# Server-only (Netlify Function). Set in Netlify site env; never prefix with VITE_.
SHEET_ID=
TOOLS_GID=
CATEGORIES_GID=

# Server-only: "Ask AI" recommender (/api/recommend). Never prefix with VITE_.
NVIDIA_API_KEY=
# Optional. NVIDIA NIM model id; defaults to the one in src/shared/recommendCore.js.
NIM_MODEL=
